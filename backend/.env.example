# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxx.mongodb.net/

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# Redis (ioredis)
# Local development: redis://localhost:6379
# Render.com Redis:  rediss://red-xxxxxxxxxxxx:6379  (copy from Render Redis dashboard)
# Leave blank to run without Redis — app falls back to MongoDB for every request
REDIS_URL=redis://localhost:6379

# Frontend URL (for CORS + password reset links)
CLIENT_URL=http://localhost:3000

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Attendance
LATE_CUTOFF_TIME=09:15
